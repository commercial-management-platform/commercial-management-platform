# Docker configuration (docker-compose.yml and docker-compose.prod.yml).
# Copy it to .env next to this file. The .env file is never committed: locally
# it holds example values; on the EC2 it is written on the server (Jenkins).
# Running the API without Docker uses backend/.env instead (DB_HOST=localhost).
#
# Each port is the same inside the container and on the host: change it here if
# it is already in use on your machine.

# App
# development locally; production on the EC2.
NODE_ENV=development
PORT=3000
# Production: the public URL of the app, e.g. http://<elastic-ip>
CORS_ORIGIN=http://localhost:5173

# Database
# Locally (and on the EC2 until RDS is ready, with --profile local-db) the API
# reaches the "postgres" service. With RDS: its endpoint, DB_SSL=true and the
# RDS credentials.
DB_HOST=postgres
DB_PORT=5432
DB_USER=cmp_user
DB_PASSWORD=change_me
DB_NAME=cmp_db
DB_SSL=false

# Authentication (betterAuth)
# Development only. In production the app refuses to start with this value:
# set a unique secret of at least 32 characters (e.g. `openssl rand -base64 32`).
BETTER_AUTH_SECRET=cmp_default_secret_key_change_in_prod_1234567890
# Production: the public URL of the app, e.g. http://<elastic-ip>
BETTER_AUTH_URL=http://localhost:3000

# Visit check-in (HU-09): radius in meters around the client's coordinates.
VISIT_CHECKIN_RADIUS_METERS=15

# Files in S3 (HU-20). On the EC2 the bucket is reached with the IAM role: do
# NOT add access keys. Locally, use your own bucket and AWS credentials.
AWS_REGION=us-east-1
S3_BUCKET_NAME=nexo-riwi-bucket-2026
# Seconds a signed URL stays valid
S3_SIGNED_URL_EXPIRES_SECONDS=300

# Seed users (npm run seed / npm run seed:prod). Fictitious values: use your own.
# A user whose email or password is missing is skipped. Passwords: 8+ characters.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me_admin
SEED_ADMIN_NAME=Administrador
SEED_DIRECTOR_EMAIL=director@example.com
SEED_DIRECTOR_PASSWORD=change_me_director
SEED_DIRECTOR_NAME=Director Comercial
SEED_ADVISOR_EMAIL=advisor@example.com
SEED_ADVISOR_PASSWORD=change_me_advisor
SEED_ADVISOR_NAME=Asesor Comercial
SEED_DEMO_PASSWORD=change_me_demo

# pgAdmin (local only, docker-compose.yml)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me
PGADMIN_PORT=5050

# Nginx with the frontend (production only, docker-compose.prod.yml)
WEB_PORT=80
