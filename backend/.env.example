# App
NODE_ENV=development
PORT=3000
# One origin or a comma-separated list
CORS_ORIGIN=http://localhost:5173

# Database (matches docker-compose.yml for local development)
DB_HOST=localhost
# If PostgreSQL is also installed natively on port 5432, run the container on another
# port (POSTGRES_HOST_PORT=5433 in the root .env) and use that same port here.
DB_PORT=5432
DB_USER=cmp_user
DB_PASSWORD=change_me
DB_NAME=cmp_db
# true on RDS (also set NODE_EXTRA_CA_CERTS to the RDS CA bundle)
DB_SSL=false

# Authentication (betterAuth)
# Development only. In production the app refuses to start with this value:
# set a unique secret of at least 32 characters (e.g. `openssl rand -base64 32`).
BETTER_AUTH_SECRET=cmp_default_secret_key_change_in_prod_1234567890
BETTER_AUTH_URL=http://localhost:3000

# Visit check-in (HU-09): radius in meters within which the advisor's
# location at /visits/:id/start is confirmed against the client's
# coordinates. Default value pending confirmation with the challenge's creator.
VISIT_CHECKIN_RADIUS_METERS=15

# Files in S3 (HU-20). On the EC2 the bucket is reached with the IAM role: do
# NOT add access keys. Locally, use your own bucket and AWS credentials.
AWS_REGION=
S3_BUCKET_NAME=
# Seconds a signed URL stays valid
S3_SIGNED_URL_EXPIRES_SECONDS=300

# Seed users (npm run seed). Fictitious values: use your own and never commit them.
# A user whose email or password is missing is skipped. Passwords: 8+ characters.
# The *_NAME variables are optional.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me_admin
SEED_ADMIN_NAME=Administrador
SEED_DIRECTOR_EMAIL=director@example.com
SEED_DIRECTOR_PASSWORD=change_me_director
SEED_DIRECTOR_NAME=Director Comercial
SEED_ADVISOR_EMAIL=advisor@example.com
SEED_ADVISOR_PASSWORD=change_me_advisor
SEED_ADVISOR_NAME=Asesor Comercial

# Demo advisors (Andrea Méndez, Carlos Núñez, Laura Ruiz, Miguel Torres) with emails
# <name>@kestrel.demo. Optional: they are skipped when this is not set. 8+ characters.
SEED_DEMO_PASSWORD=change_me_demo
# Optional (YYYY-MM-DD): the day the demo data treats as "today". Visits before it are done,
# after it scheduled. Defaults to today in America/Bogota.
# SEED_REFERENCE_DATE=2026-10-26
