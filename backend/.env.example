# App
NODE_ENV=development
PORT=3000
# One origin or a comma-separated list
CORS_ORIGIN=http://localhost:5173

# Database (matches docker-compose.yml for local development)
DB_HOST=localhost
DB_PORT=5432
DB_USER=cmp_user
DB_PASSWORD=change_me
DB_NAME=cmp_db
# true on RDS (also set NODE_EXTRA_CA_CERTS to the RDS CA bundle)
DB_SSL=false

# Authentication (betterAuth)
BETTER_AUTH_SECRET=cmp_default_secret_key_change_in_prod_1234567890
BETTER_AUTH_URL=http://localhost:3000
